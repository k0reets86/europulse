{
  "date": "2026-03-15",
  "sources": [
    "https://web.dev/articles/responsive-web-design-basics",
    "https://developer.mozilla.org/en-US/docs/Learn_web_development/Core/CSS_layout/Responsive_Design",
    "https://www.w3.org/WAI/WCAG22/Understanding/target-size-minimum.html"
  ],
  "principles": [
    "one_responsive_system_only",
    "mobile_first_rules",
    "breakpoints_based_on_layout_pressure",
    "no_parallel_mobile_desktop_logic_for_same_block",
    "touch_targets_large_enough",
    "text_budgets_tied_to_layout_zone"
  ],
  "breakpoints": [
    { "name": "xs_phone", "min": 0, "max": 479 },
    { "name": "phone", "min": 480, "max": 767 },
    { "name": "tablet", "min": 768, "max": 1023 },
    { "name": "small_laptop", "min": 1024, "max": 1279 },
    { "name": "desktop", "min": 1280, "max": 1599 },
    { "name": "wide_desktop", "min": 1600, "max": 9999 }
  ],
  "systems": {
    "header": [
      "utility_bar_one_row_on_phones",
      "social_icons_no_wrap",
      "search_available_in_header_and_mobile_menu",
      "logo_single_behavior"
    ],
    "ticker": [
      "single_animation_model",
      "single_label_sizing_model",
      "duplicated_marquee_groups",
      "same_logic_all_languages"
    ],
    "hero": [
      "fixed_structural_slots",
      "title_excerpt_budgets_per_breakpoint",
      "chip_alignment_consistent",
      "hero_meta_separate_from_generic_card_meta"
    ],
    "cards": [
      "date_then_categories",
      "single_dot_model",
      "card_heights_controlled_by_zone",
      "single_column_collapse_keeps_story_counts"
    ],
    "footer": [
      "same_font_family_as_main_nav",
      "scaled_spacing_on_narrow_screens"
    ],
    "ads": [
      "slot_type_adaptation",
      "no_generic_background_crop_hacks"
    ]
  },
  "content_budgets": {
    "hero_title_small_phone_lines": 4,
    "hero_title_desktop_lines": 4,
    "hero_excerpt_small_phone_lines": 4,
    "hero_excerpt_desktop_lines": 3
  },
  "current_status": {
    "fully_unified": false,
    "authoritative_layer": "/var/www/europulse/public/wp-content/mu-plugins/europulse-normalize.css"
  }
}
